{
  "name": "@kweela/fiber-ledger",
  "version": "0.1.6",
  "description": "A CKB ledger with Fiber payment channels: embedded wallets, capacity and xUDT balances, and off-chain settlement",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs"
    }
  },
  "homepage": "https://fiberledger.kweela.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/kweela/fiber-ledger"
  },
  "keywords": [
    "ckb",
    "nervos",
    "fiber",
    "payment-channels",
    "ledger",
    "wallet",
    "xudt"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm lint && tsc --noEmit && vitest run && tsdown",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.23.0"
  },
  "peerDependencies": {
    "@ckb-ccc/connector-react": "^2.2.2",
    "@kweela/ledger": "^0.1.2",
    "react": ">=18"
  },
  "devDependencies": {
    "@ckb-ccc/connector-react": "^2.2.2",
    "@eslint/js": "^10.0.1",
    "@kweela/ledger": "^0.1.2",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}